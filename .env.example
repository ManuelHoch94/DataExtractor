# ── Provider selector ────────────────────────────────────────────────────────
# "openai" (default) or "anthropic"
LLM_PROVIDER=openai

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
# Optional: override for Azure OpenAI, vLLM, LM Studio, or any internal model
# OPENAI_BASE_URL=http://localhost:8000/v1

# ── Anthropic (only needed when LLM_PROVIDER=anthropic) ──────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Extraction behaviour ──────────────────────────────────────────────────────
EXTRACTION_CONFIDENCE_THRESHOLD=0.5
EXTRACTION_MAX_TOKENS=2048
LOG_LEVEL=INFO
